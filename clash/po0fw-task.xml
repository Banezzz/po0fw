<?xml version="1.0"?>
<!--
  po0 firewall auto-whitelist - Windows Task Scheduler template.

  Replace __PO0FW_DIR__ with the absolute directory holding po0fw.ps1
  before importing. See clash/README.md for the one-liner that does the
  substitution and registers the task.

  Deliberately ASCII-only: schtasks.exe /XML is picky about file encoding,
  and non-ASCII text here is a common source of import failures. All the
  Chinese documentation lives in clash/README.md instead.

  The XML declaration deliberately carries NO encoding attribute. Get-Content
  hands Register-ScheduledTask a .NET string, which is UTF-16 in memory; if the
  declaration claimed UTF-8, the Task Scheduler parser rejects it with
  "The task XML is malformed / cannot switch encoding" at (1,40). Omitting the
  attribute keeps this file valid both as a UTF-8 file on disk (schtasks /XML,
  GUI import) and as an in-memory string (Register-ScheduledTask -Xml).

  Triggers:
    - every 10 minutes, indefinitely
    - 1 minute after boot
    - NetworkProfile event 10000 ("network connected"), i.e. the Windows
      equivalent of Surge's network-changed, with a 10s settle delay

  Runs as SYSTEM (S-1-5-18): no stored password, runs whether or not a user
  is logged on, and no console window ever flashes.
-->
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>Report this machine's egress IP to the po0 firewall whitelist.</Description>
    <URI>\po0fw-whitelist</URI>
  </RegistrationInfo>
  <Triggers>
    <TimeTrigger>
      <Repetition>
        <Interval>PT10M</Interval>
        <StopAtDurationEnd>false</StopAtDurationEnd>
      </Repetition>
      <StartBoundary>2026-01-01T00:00:00</StartBoundary>
      <Enabled>true</Enabled>
    </TimeTrigger>
    <BootTrigger>
      <Enabled>true</Enabled>
      <Delay>PT1M</Delay>
    </BootTrigger>
    <EventTrigger>
      <Enabled>true</Enabled>
      <Subscription>&lt;QueryList&gt;&lt;Query Id="0" Path="Microsoft-Windows-NetworkProfile/Operational"&gt;&lt;Select Path="Microsoft-Windows-NetworkProfile/Operational"&gt;*[System[Provider[@Name='Microsoft-Windows-NetworkProfile'] and (EventID=10000)]]&lt;/Select&gt;&lt;/Query&gt;&lt;/QueryList&gt;</Subscription>
      <Delay>PT10S</Delay>
    </EventTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <UserId>S-1-5-18</UserId>
      <RunLevel>HighestAvailable</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>false</WakeToRun>
    <ExecutionTimeLimit>PT5M</ExecutionTimeLimit>
    <Priority>7</Priority>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>powershell.exe</Command>
      <Arguments>-NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File "__PO0FW_DIR__\po0fw.ps1"</Arguments>
      <WorkingDirectory>__PO0FW_DIR__</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
