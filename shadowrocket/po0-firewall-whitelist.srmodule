#!name=po0 防火墙自动加白
#!desc=安装后：配置 → 模块 → 点击本模块 → 编辑参数，把 tokens 换成你的 pgnfw_ token（多台机器用 | 分割）。network-changed 事件与每 10 分钟 cron 自动触发。
#!author=reallinzc
#!homepage=https://github.com/Banezzz/po0fw
#!arguments=tokens:请通过编辑参数填入pgnfw_token
#!arguments-desc=tokens：po0 防火墙 API token（pgnfw_ 开头），多台机器用 | 分割（不要用逗号）；可选在 token 后加 @槽位（如 pgnfw_xxx@0）钉固定坑位、永不被淘汰

[Rule]
IP-CIDR,124.221.69.228/32,DIRECT,no-resolve

[Script]
po0-fw-cron = type=cron,cronexpr="*/10 * * * *",script-path=https://raw.githubusercontent.com/Banezzz/po0fw/main/scripts/po0-firewall-whitelist.js,timeout=60,argument=tokens={{{tokens}}}
po0-fw-event = type=event,event-name=network-changed,script-path=https://raw.githubusercontent.com/Banezzz/po0fw/main/scripts/po0-firewall-whitelist.js,timeout=60,argument=tokens={{{tokens}}}
po0-fw-panel = type=generic,script-path=https://raw.githubusercontent.com/Banezzz/po0fw/main/scripts/po0-firewall-whitelist.js,timeout=60,argument=tokens={{{tokens}}}

# Shadowrocket 对 [Panel] 的支持随版本而异：能渲染就多一个手动刷新与查看
# 白名单占用的入口，不能渲染则整段惰性忽略，不影响上面的 cron / event。
[Panel]
po0-fw = script-name=po0-fw-panel,title=po0 防火墙加白,content=点击刷新,update-interval=300
