#!name=po0 防火墙自动加白
#!desc=调用 po0 防火墙 API 将本机当前出口 IP 加入白名单。支持多 token（英文逗号分割），network-changed 事件与每 10 分钟 cron 自动触发。每次运行都会写一行脚本日志（console.log），通知方式可在插件设置里选。
#!author=reallinzc
#!homepage=https://github.com/Banezzz/po0fw
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Panel.png

[Argument]
tokens = input,"",tag=API tokens,desc=po0 防火墙 API token（pgnfw_ 开头）；多台机器用英文逗号分割；可选 token 后加 @槽位（如 pgnfw_xxx@0）钉固定坑位永不被淘汰
notify = select,"change","always","fail","off",tag=通知方式,desc=change：出口或加白状态变了才通知（默认，平时静默）；always：每次运行都通知（排查「到底有没有自动执行」时用）；fail：没全部成功才通知；off：不通知

[Rule]
IP-CIDR,124.221.69.228/32,DIRECT,no-resolve

[Script]
cron "*/10 * * * *" script-path=https://raw.githubusercontent.com/Banezzz/po0fw/main/scripts/po0-firewall-whitelist.js, timeout=60, tag=po0-fw-cron, argument=[{tokens},{notify}]
network-changed script-path=https://raw.githubusercontent.com/Banezzz/po0fw/main/scripts/po0-firewall-whitelist.js, timeout=60, tag=po0-fw-event, argument=[{tokens},{notify}]
